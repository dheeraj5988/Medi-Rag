# GEMINI_API_KEY is OPTIONAL.
# Without it the app still works: the symptom model, MedlinePlus keyword retrieval and the offline chat view run locally.
# With it you also get: free-text understanding in any language, written explanations, streamed chat answers.
# Get a free key at https://aistudio.google.com/apikey and keep it private (never commit .env).
GEMINI_API_KEY=""

# Optional: requests per minute allowed per IP on /api/gemini/* (default 40). Useful if you deploy publicly.
# RATE_LIMIT_PER_MINUTE=40

# Optional: embedding model used by `npm run build-kb`
# EMBEDDING_MODEL=gemini-embedding-2

# PORT=3000
